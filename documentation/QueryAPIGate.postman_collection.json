{
  "info": {
    "name": "QueryAPIGate",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests against the example APIs (queryapigate examples load && queryapigate serve): the examples connection and its generated film data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Query",
      "item": [
        {
          "name": "Execute SQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/execute_sql?format=json&page=1&page_size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "execute_sql"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "json"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sql\": \"SELECT * FROM film WHERE film_id > :min\",\n    \"params\": {\n        \"min\": 10\n    },\n    \"connection_name\": \"examples\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Execute SQL (CSV)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/execute_sql?format=csv&page_size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "execute_sql"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "csv"
                },
                {
                  "key": "page_size",
                  "value": "5"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sql\": \"SELECT * FROM customer\",\n    \"connection_name\": \"examples\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Saved queries",
      "item": [
        {
          "name": "Save a query (published at once)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/queries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "queries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"film_by_id\",\n    \"sql\": \"SELECT * FROM film WHERE film_id = :id\",\n    \"parameters\": {\n        \"id\": \"int\"\n    },\n    \"connection_name\": \"examples\",\n    \"author\": \"me\",\n    \"description\": \"Look up a film\",\n    \"tags\": [\n        \"example\"\n    ],\n    \"publish\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Run a saved query (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/q/film_by_id?id=7",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "q",
                "film_by_id"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "7"
                }
              ]
            }
          }
        },
        {
          "name": "Run a saved query (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/q/film_by_id?format=yaml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "q",
                "film_by_id"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "yaml"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"params\": {\n        \"id\": 7\n    },\n    \"version\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Run by file path",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/execute_sql_from_file?page_size=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "execute_sql_from_file"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "2"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"filepath\": \"saved_sql/film_by_id.json\",\n    \"connection_name\": \"examples\",\n    \"placeholders\": {\n        \"id\": 7\n    },\n    \"format\": \"csv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List saved queries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/queries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "queries"
              ]
            }
          }
        },
        {
          "name": "Get a saved query, with every version",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/queries/film_by_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "queries",
                "film_by_id"
              ]
            }
          }
        },
        {
          "name": "Delete a version",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/queries/film_by_id/versions/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "queries",
                "film_by_id",
                "versions",
                "2"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "List connections",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/connections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "connections"
              ]
            }
          }
        },
        {
          "name": "Add a connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/connections",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "connections"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"reporting\",\n    \"db\": \"postgres\",\n    \"host\": \"localhost\",\n    \"port\": 5432,\n    \"database\": \"postgres\",\n    \"user\": \"postgres\",\n    \"password\": \"${POSTGRES_PASSWORD}\",\n    \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete a connection",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/connections/reporting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "connections",
                "reporting"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"reason\": \"no longer needed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Service",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "OpenAPI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          }
        }
      ]
    }
  ]
}
