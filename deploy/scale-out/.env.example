# Copy to .env (chmod 600) and fill in. Never commit .env.

# Pin a release: an upgrade should be a deliberate change of this line (see DEPLOYMENT.md, Rolling upgrades).
QUERYAPIGATE_IMAGE=ghcr.io/anantharajuc/queryapigate:0.15.0

# The domain Caddy serves and gets a certificate for. "localhost" uses a local certificate, for trying it out.
SITE_ADDRESS=localhost

# The admin key - long and random: openssl rand -hex 32
QUERYAPIGATE_API_KEY=

# The store's password (the PostgreSQL container is created with it).
POSTGRES_PASSWORD=

# Encrypts connection passwords in the store - the same value on every instance. Keep a copy in your secret manager.
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
QUERYAPIGATE_SECRET_KEY=
